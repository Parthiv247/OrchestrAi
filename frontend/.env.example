# ── OrchestrAI Frontend — Environment Variables ───────────────────────────────
# Copy this file to .env.local for local dev.
# For Vercel: add these in Project → Settings → Environment Variables.
# Never commit .env.local to version control.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash).
# Local dev:   http://localhost:8000
# Railway:     https://orchestrai-backend.up.railway.app
# Render:      https://orchestrai-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Brandfetch logo CDN — used for connector brand logos (free tier works fine)
# Get your key at: https://brandfetch.com/developers
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=your_brandfetch_client_id_here

# ── VERCEL DEPLOYMENT CHECKLIST ───────────────────────────────────────────────
# 1. Deploy backend to Railway first → copy the Railway URL
# 2. In Vercel dashboard → Settings → Environment Variables
#    Set NEXT_PUBLIC_API_URL = https://your-backend.up.railway.app
# 3. Redeploy frontend — Vercel bakes env vars at build time (important!)
# 4. In Railway backend env vars, set:
#    CORS_ORIGINS = https://your-frontend.vercel.app

