# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" in deployments to enforce JWT auth and disable the
# X-Dev-Mode bypass header. Leave as "development" for local dev.
APP_ENV=development

# CORS allowed origins — comma-separated. Leave blank in dev (defaults to *).
# In production, set explicit origins: CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=

# Internal URL used by healing agents to call the notifications API.
# In docker-compose this is http://backend:8000; locally use http://localhost:8000
INTERNAL_API_URL=http://localhost:8000

# ─── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── LangChain / LangSmith (optional — for LangSmith tracing) ─────────────────
# Get from: smith.langchain.com → Settings → API Keys
LANGCHAIN_API_KEY=your_langchain_key_here
LANGSMITH_API_KEY=your_langsmith_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestrai
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_password

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# ─── Alerts & Email Approval ──────────────────────────────────────────────────
ALERT_EMAIL=admin@example.com

# SMTP (Gmail: use App Password from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Base URL for approval links in emails
API_BASE_URL=http://localhost:8000

# ─── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin


# ─── Snowflake (leave blank to use PostgreSQL fallback schema snowflake_dest) ─
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DB=ORCHESTRAI
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=
SNOWFLAKE_CREDIT_PRICE=2.5
